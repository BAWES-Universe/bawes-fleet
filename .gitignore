# Secrets — never commit
.env
.env.*
*.pem
*.key
secrets/
*.p12
*.jks

# Raw data — summaries only (CI blocks these too)
raw-data/
*.sql.gz
*.sql
*.csv
*.jsonl
# EXCEPTION: the live ledger is the economy's truth — never ignored, always backed up
!ledger-live/
!ledger-live/register/
!ledger-live/register/*.jsonl
!ledger-live/register/*.log
!ledger-live/orchestrator/
!ledger-live/orchestrator/*.jsonl

# Tooling noise
.venv/
__pycache__/
*.pyc
node_modules/
.DS_Store
